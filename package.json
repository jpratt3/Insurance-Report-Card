{
  "name": "abc-insurance-report-card",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack -p 9000",
    "build": "next build",
    "start": "next start -p 9000",
    "seed": "npx tsx src/lib/seed.ts",
    "seed:sample": "npx tsx src/lib/seed-sample.ts",
    "benchmarks:check": "npx tsx scripts/check-benchmarks.ts",
    "financials:check": "npx tsx scripts/check-financials.ts",
    "score:snapshot": "npx tsx scripts/score-snapshot.ts",
    "verify": "npx tsc --noEmit && npm run benchmarks:check && npm run financials:check && npm run score:snapshot"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.124.0",
    "next": "^15.5.2",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  }
}
